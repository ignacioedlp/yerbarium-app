EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Match the API environment; optional override for preview/release builds.
EXPO_PUBLIC_PUSH_ENVIRONMENT=development
# EAS file variable path, or an ignored local google-services.json.
# GOOGLE_SERVICES_JSON=/path/to/google-services.json

# Google Cloud iOS OAuth client for app.yerbarium.mobile (public identifier).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Maps SDK for Android: restrict this client key to package + signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# AdMob: enable only after setting production app + banner IDs and rebuilding.
ADMOB_IOS_APP_ID=ca-app-pub-5417303700723818~9691245960
ADMOB_ANDROID_APP_ID=ca-app-pub-5417303700723818~3772916905
EXPO_PUBLIC_ADMOB_ENABLED=false
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-5417303700723818/3273227603
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-5417303700723818/5604486280
EXPO_PUBLIC_ADMOB_IOS_CATALOG_BANNER_ID=ca-app-pub-5417303700723818/8472537218
EXPO_PUBLIC_ADMOB_ANDROID_CATALOG_BANNER_ID=ca-app-pub-5417303700723818/7959186887
