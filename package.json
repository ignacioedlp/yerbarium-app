{
  "name": "yerbarium-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "branding:generate": "node scripts/generate-branding.mjs",
    "dev:ios": "expo start --dev-client --ios",
    "dev:android": "expo start --dev-client --android",
    "start:go": "expo start --go"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/ui": "~57.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-persist-client": "^5.90.0",
    "axios": "^1.12.2",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "^57.0.19",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-hook-form": "^7.65.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react-native-screens": "~4.26.0"
  }
}
