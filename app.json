{
  "expo": {
    "name": "Yerbarium",
    "slug": "yerbarium",
    "version": "1.0.0",
    "scheme": "yerbarium",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.yerbarium.mobile",
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "package": "app.yerbarium.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-foreground.png",
        "backgroundImage": "./assets/branding/android-background.png",
        "backgroundColor": "#0c5947",
        "monochromeImage": "./assets/branding/android-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f4f0e4"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/branding/icon.png"
  }
}
